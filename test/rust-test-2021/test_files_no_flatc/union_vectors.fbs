table Inner {
  value: uint8;
}

union Union {
  String: string,
  InnerTable,
  InnerStruct,
  InnerStruct64,
  InnerStruct16,
}

table Root {
  value: [Union];
}

table InnerTable {
  value: uint8;
}

struct InnerStruct {
  value: uint8;
}

struct InnerStruct64 {
  value: uint64;
}

struct InnerStruct16 (force_align: 16) {
  value: uint8;
}
